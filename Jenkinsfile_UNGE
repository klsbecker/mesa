// Jenkins-specific scheduling config
def TEST_NIGHTLY_BRANCH_NAME = 'master.nightly'
def TEST_NIGHTLY_TIME_HOUR   = 20
def TEST_NIGHTLY_TIME_MIN    = 0
def PIPELINE_TIMEOUT_HOURS   = 6

// Run a named suite type ("nightly" or "basic") on all systems in parallel,
// all writing results into the same shared session directory.
def runTestsOnAllSystems = { suiteType, sessionDir ->
    def config    = readYaml file: 'mesa/demo/test/utils/dispatch/test-config.yaml'
    def suites    = config["suites_${suiteType}"]
    def suiteArgs = suites.collect { "-T \"${it}\"" }.join(" ")
    // Run all systems in parallel.
    // Each system gets its own console log file and is wrapped in catchError so
    // one DUT failure does not abort siblings — every system's log survives.
    parallel config.systems.collectEntries { s ->
        ["${s.system} (${s.dut})", {
            catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', message: "Tests failed for ${s.system} (${s.dut})") {
                container('pod-mesa-base') {
                    def branchArg = (suiteType == 'nightly') ? "--branch \"${s.branch}\"" : ""
                    def logFile = "${sessionDir}/${s.system}.console.log"
                    sh "mkdir -p '${sessionDir}'"
                    def rc = sh(returnStatus: true, script: """set -o pipefail; ./mesa/demo/test/utils/dispatch/run-suites-on.rb -s "${s.system}" -i "${s.image}" -o "${sessionDir}" -t "${config.timeout}" ${suiteArgs} ${branchArg} 2>&1 | tee "${logFile}" """)
                    if (rc == 7) {
                        unstable("Reserve timed out for ${s.system} (${s.dut})")
                    } else if (rc != 0) {
                        error("Tests failed for ${s.system} (${s.dut})")
                    }
                }
            }
        }]
    }
}

// Generate combined Allure report from all system results and publish
def generateReport = { suiteType, sessionDir ->
    def config     = readYaml file: 'mesa/demo/test/utils/dispatch/test-config.yaml'
    def suiteArgs  = config["suites_${suiteType}"].collect { "--suite \"${it}\"" }.join(" ")
    withCredentials([sshUserPrivateKey(credentialsId: 'lon-vm-ung-mdi', keyFileVariable: 'keyfile')]) {
        sh """./mesa/demo/test/utils/dispatch/generate-report.rb -o "${sessionDir}" ${suiteArgs} --publish --report-only --keyfile \$keyfile"""
    }
}

// ============================================================================================================
// Pipeline
// ============================================================================================================

pipeline {
    // Options directive is for configuration that applies to the whole job
    options {
        timestamps ()
                // Keep more builds so a failing nightly is still around for forensics.
                buildDiscarder(logRotator(numToKeepStr:'20'))
                // Make sure this build ad tests don't hang forever
                timeout(time: PIPELINE_TIMEOUT_HOURS, unit: 'HOURS')
                skipDefaultCheckout()
                // Flush pipeline state to disk on every step so a controller/agent
                // crash leaves a readable build log instead of an empty file.
                durabilityHint('MAX_SURVIVABILITY')
    }

    agent { kubernetes { yamlFile '.cmake/pod-base.yaml' } }

    environment {
        USER_NAME = "jenkins"
        WORK_DIR = "/home/$USER_NAME"
        BLD_ID = "${env.BUILD_NUMBER}"
        top = "${env.WORKSPACE}"
        GIT_BRANCH = "${env.BRANCH_NAME}"
        PATH = "${env.WORKSPACE}/support/scripts/:" +
               "${env.WORKSPACE}/build-host/appl/test:" +
               "${env.WORKSPACE}/build-generic/appl/test:" +
               "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:" +
               "/easytest/easytest/utils:" +
               "/easytest/easytest/test-setup-server:" + 
               "/opt/allure/bin"
    }

    triggers { cron(env.BRANCH_NAME == TEST_NIGHTLY_BRANCH_NAME ? "TZ=Europe/Copenhagen\n${TEST_NIGHTLY_TIME_MIN} ${TEST_NIGHTLY_TIME_HOUR} * * *" : '') }

    stages {
        stage("Checkout") {
            steps {
                container('pod-mesa-base') {
                    checkout([
                             $class: 'GitSCM',
                             branches: scm.branches,
                             extensions: scm.extensions + [[$class: 'CloneOption', noTags: false, shallow: false]],
                             userRemoteConfigs: scm.userRemoteConfigs
                    ])

                    sh """
                        git config --global --add safe.directory '*'
                        git clean -qffdx
                        .cmake/source-prepare.rb ws
                        mkdir images
                    """
                    stash name: "src", includes: "ws.tar"
                }
            }
        }
        stage('Prepare for tests (nightly)') {
            when { triggeredBy 'TimerTrigger' }
            steps {
                container('pod-mesa-base') {
                    sh 'git checkout -B master --track origin/master'
                    sh 'git reset --hard origin/master'
                    sh 'git clean -qffdx'
                    sh 'mkdir images'
                    sh '.cmake/source-prepare.rb ws'
                    stash name: "src", includes: "ws.tar"
                }
            }
        }
        stage('Build in parallel') {
            parallel {
                stage("arm64 + coverity") {
                    agent { kubernetes { yamlFile '.cmake/pod-build.yaml' } }
                    stages {
                        stage("arm64") {
                            steps {
                                container('pod-mesa-build') {
                                    unstash name: "src"
                                    sh "tar -xf ws.tar && rm ws.tar"
                                    sh "./.cmake/create_cmake_project.rb -vfnp arm64 arm64"
                                    stash name: "bin-arm64", includes: "arm64.tar"
                                }
                            }
                        }

                        stage("coverity") {
                            steps {
                                container('pod-mesa-build') {
                                    script {
                                        // Run the script and get the exit status
                                        // Running coverity only for arm64 compiler, as we are running coverity for MEPA lib which gets covered for all MEPA libraries
                                        def result = sh(script: "./.cmake/mepa_coverity.rb -t arm64 static_analysis_reports", returnStatus: true)

                                        if (result == 0) {
                                            echo "Coverity script completed successfully."
                                            currentBuild.result = 'SUCCESS'
                                        } else if (result == 1) {
                                            echo "Coverity script found issues. Marking build as UNSTABLE."
                                            currentBuild.result = 'UNSTABLE'
                                        } else {
                                            error "Coverity script failed with unexpected exit code: ${result}"
                                        }
                                        stash name: "ana-report", includes: "static_analysis_reports/**"
                                    }
                                }
                            }
                        }
                    }
                }
                stage("arm") {
                    agent { kubernetes { yamlFile '.cmake/pod-build.yaml' } }
                    steps {
                        container('pod-mesa-build') {
                            unstash name: "src"
                            sh "tar -xf ws.tar && rm ws.tar"
                            sh "./.cmake/create_cmake_project.rb -vfnp arm arm"
                            stash name: "bin-arm", includes: "arm.tar"
                        }
                    }
                }
                stage("mips") {
                    agent { kubernetes { yamlFile '.cmake/pod-build.yaml' } }
                    steps {
                        container('pod-mesa-build') {
                            unstash name: "src"
                            sh "tar -xf ws.tar && rm ws.tar"
                            sh "./.cmake/create_cmake_project.rb -vfnp mipsel mipsel"
                            stash name: "bin-mipsel", includes: "mipsel.tar"
                        }
                    }
                }
                stage("hallberg-arm (nightly)") {
                    when { triggeredBy 'TimerTrigger' }
                    agent { kubernetes { yamlFile '.cmake/pod-build.yaml' } }
                    steps {
                        container('pod-mesa-build') {
                            checkout([
                                $class: 'GitSCM',
                                branches: [[name: 'origin/master.hallberg-2']],
                                extensions: [[$class: 'CloneOption', noTags: false, shallow: false]],
                                userRemoteConfigs: scm.userRemoteConfigs
                            ])
                            sh """
                                git config --global --add safe.directory '*'
                                git clean -qffdx
                                .cmake/source-prepare.rb ws
                            """
                            sh "tar -xf ws.tar && rm ws.tar"
                            sh "./.cmake/create_cmake_project.rb -vfnb arm arm"
                            stash name: "bin-hallberg", includes: "arm/mesa/demo/armv7_lan932x_fpga.itb"
                        }
                    }
                }
                stage("lmstax-check") {
                    agent { kubernetes { yamlFile '.cmake/pod-misra-lmstax.yaml' } }
                    steps {
                        container('velocitysp-builder') {
                            unstash name: "src"
                            sh "tar -xf ws.tar"
                            sh "./.cmake/misra-lan969x_lm"
                        }
                    }
                }
                stage("misc") {
                    stages {
                        stage('Style') {
                            steps {
                                container('pod-mesa-base') {
                                    warnError (message: "Style error") {
                                        sh './.cmake/style -c -a'
                                    }
                                }
                            }
                        }
                        stage('Copyright') {
                            steps {
                                container('pod-mesa-base') {
                                    warnError (message: "Copyright error") {
                                        sh './.cmake/copyright.rb'
                                    }
                                }
                            }
                        }
                        stage('License') {
                            steps {
                                container('pod-mesa-base') {
                                    warnError (message: "License error") {
                                        sh './.cmake/build-licenses.rb'
                                    }
                                }
                            }
                        }
                        stage('Docs') {
                            steps {
                                container('pod-mesa-base') {
                                    warnError (message: "Docs error") {
                                        sh './.cmake/build-docs.rb'
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        stage("Prepare tests (nightly)") {
            when { triggeredBy 'TimerTrigger' }
            steps {
                container('pod-mesa-base') {
                    unstash name: "bin-arm64"
                    unstash name: "bin-arm"
                    unstash name: "bin-hallberg"
                    unstash name: "bin-mipsel"
                    sh "tar -xf arm64.tar && rm arm64.tar"
                    sh "tar -xf arm.tar && rm arm.tar"
                    sh "tar -xf mipsel.tar && rm mipsel.tar"
                }
            }
        }
        stage("Run test suites (nightly)") {
            when { triggeredBy 'TimerTrigger' }
            options {
                // Explicit stage-level cap so an abort here is clearly attributed
                // to the test stage rather than the generic pipeline timeout.
                timeout(time: 5, unit: 'HOURS')
            }
            steps {
                catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                    script {
                        def sessionDir = "easytest-logs/nightly-${env.BUILD_NUMBER}"
                        runTestsOnAllSystems("nightly", sessionDir)
                    }
                }
            }
            post {
                always {
                    // Archive per-system console logs immediately, even if the
                    // Publish stage never runs (e.g. mass test failure path).
                    archiveArtifacts artifacts: 'easytest-logs/**/*.console.log', allowEmptyArchive: true
                }
            }
        }
        stage("Publish report (nightly)") {
            when { triggeredBy 'TimerTrigger' }
            steps {
                container('pod-mesa-base') {
                    catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                        script {
                            def sessionDir = "easytest-logs/nightly-${env.BUILD_NUMBER}"
                            generateReport("nightly", sessionDir)
                        }
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: '**/easytest-logs/**/*', allowEmptyArchive: true
                    junit testResults: '**/easytest-logs/**/*_JUNIT.xml', allowEmptyResults: true
                }
            }
        }
        stage("Aggregate Binaries") {
            steps {
                withCredentials([usernamePassword(credentialsId: 'Test4', usernameVariable: 'ARTIFACTORY_USER', passwordVariable: 'ARTIFACTORY_PASS')]) {
                    container('pod-mesa-base') {
                        unstash name: "bin-mipsel"
                        unstash name: "bin-arm64"
                        unstash name: "bin-arm"
                        unstash name: "ana-report"
                        sh ".cmake/aggr-artifacts.rb"
                    }
                }
            }
        }
    }
    post {
        success {
            echo "Pipeline Success! Project: ${env.JOB_NAME}, Build Number: ${env.BUILD_NUMBER}"
        }
        unstable {
            echo "Pipeline Unstable! Project: ${env.JOB_NAME}, Build Number: ${env.BUILD_NUMBER}"
        }
        aborted {
            echo "Pipeline Aborted! Project: ${env.JOB_NAME}, Build Number: ${env.BUILD_NUMBER}"
        }
        failure {
            echo "Pipeline Failure! Project: ${env.JOB_NAME}, Build Number: ${env.BUILD_NUMBER}"
        }
        always {
            archiveArtifacts artifacts: 'images/*'
        }
    }
}
